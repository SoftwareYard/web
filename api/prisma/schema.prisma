generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminRole {
  id   String @id @default(cuid())
  name String @unique

  adminUsers AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  roleId    String    @map("role_id")
  role      AdminRole @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  timeOffReviews TimeOffRequest[] @relation("TimeOffReviews")

  @@map("admin_users")
}

enum TimeOffStatus {
  Pending
  Approved
  Rejected
  Cancelled

  @@map("time_off_status")
}

enum TimeOffType {
  Annual
  Special

  @@map("time_off_type")
}

model PublicHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_holidays")
}

model TimeOffRequest {
  id           String        @id @default(cuid())
  employeeId   String        @map("employee_id")
  employee     TeamMember    @relation("TimeOffRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  startDate    DateTime      @map("start_date")
  endDate      DateTime      @map("end_date")
  workingDays  Int           @map("working_days")
  reason       String?
  type         TimeOffType   @default(Annual)
  status       TimeOffStatus @default(Pending)
  reviewedById String?       @map("reviewed_by_id")
  reviewedBy   AdminUser?    @relation("TimeOffReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?       @map("review_note")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("time_off_requests")
}

model TimeOffBalance {
  id              String     @id @default(cuid())
  employeeId      String     @map("employee_id")
  employee        TeamMember @relation("TimeOffBalances", fields: [employeeId], references: [id], onDelete: Cascade)
  year            Int
  allowanceDays   Int        @default(20) @map("allowance_days")
  carriedOverDays Int        @default(0) @map("carried_over_days")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@unique([employeeId, year])
  @@map("time_off_balances")
}

model TeamMember {
  id                  String    @id @default(cuid())
  name                String
  role                String
  image               String    @default("")
  bio                 String    @default("")
  email               String?   @unique
  phone               String?
  password            String?
  archiveNo           String?   @map("archive_no")
  address             String?
  city                String?
  embg                String?
  dateOfBirth         DateTime? @map("date_of_birth")
  secondContactName   String?   @map("second_contact_name")
  secondContactPhone  String?   @map("second_contact_phone")
  hireDate            DateTime? @map("hire_date")
  annualLeaveDays     Int       @default(20) @map("annual_leave_days")
  currentSalaryEur    Float?    @map("current_salary_eur")
  currentSalaryGross  Float?    @map("current_salary_gross")
  invoiceValue        Float?    @map("invoice_value")
  managementFee       Float?    @map("management_fee")
  contractInMonths    Int?      @map("contract_in_months")
  lastContractDate    DateTime? @map("last_contract_date")
  nextContractDate    DateTime? @map("next_contract_date")
  contractDocumentUrl String?   @map("contract_document_url")
  clientId            String?   @map("client_id")
  client              Client?   @relation(fields: [clientId], references: [id])
  sortOrder           Int       @default(0) @map("sort_order")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  oneOnOneMeetings OneOnOneMeeting[]
  notes            MemberNote[]
  payrises         Payrise[]
  assets           Asset[]
  assetHistory     AssetHistory[]
  timeOffRequests  TimeOffRequest[]  @relation("TimeOffRequests")
  timeOffBalances  TimeOffBalance[]  @relation("TimeOffBalances")

  @@map("team_members")
}

model Client {
  id           String   @id @default(cuid())
  title        String
  contractDate DateTime @map("contract_date")
  domain       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teamMembers TeamMember[]
  jobs        Job[]

  @@map("clients")
}

model ContractType {
  id   String @id @default(cuid())
  type String @unique

  @@map("contract_types")
}

model OneOnOneMeeting {
  id                     String     @id @default(cuid())
  userId                 String     @map("user_id")
  user                   TeamMember @relation(fields: [userId], references: [id])
  date                   DateTime
  feelingAtWork          String?    @map("feeling_at_work")
  thingsOutsideWork      String?    @map("things_outside_work")
  currentWorkload        String?    @map("current_workload")
  problemsWithClient     String?    @map("problems_with_client")
  problemsWithTeam       String?    @map("problems_with_team")
  skillsToDevelop        String?    @map("skills_to_develop")
  growingInRole          String?    @map("growing_in_role")
  trainingOpportunities  String?    @map("training_opportunities")
  anythingElse           String?    @map("anything_else")
  improvementSuggestions String?    @map("improvement_suggestions")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  @@map("one_on_one_meetings")
}

// Dated notes on a team member: what HR noted and what the member said
model MemberNote {
  id          String     @id @default(cuid())
  memberId    String     @map("member_id")
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date        DateTime
  hrNotes     String?    @map("hr_notes")
  memberNotes String?    @map("member_notes")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([memberId])
  @@map("member_notes")
}

model Payrise {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  user        TeamMember @relation(fields: [userId], references: [id])
  netSalary   Float      @map("net_salary")
  grossSalary Float      @map("gross_salary")
  date        DateTime
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("payrises")
}

model Job {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  department       String
  location         String
  type             String
  description      String
  requirements     String[]
  responsibilities String[]
  benefits         String[]
  goodToHave       String[]    @default([]) @map("good_to_have")
  technologyId     String?     @map("technology_id")
  technology       Technology? @relation(fields: [technologyId], references: [id])
  // Internal only: which client the hire is for — never returned publicly
  clientId         String?     @map("client_id")
  client           Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  postedDate       DateTime    @map("posted_date")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  applications JobApplication[]

  @@map("jobs")
}

model Technology {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("technologies")
}

model CandidateRole {
  id   String @id @default(cuid())
  name String @unique

  jobApplications JobApplication[]
  cvScreenings    CvScreening[]

  @@map("candidate_roles")
}

model Store {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets   Asset[]
  expenses Expense[]

  @@map("stores")
}

model ExpenseType {
  id        String   @id @default(cuid())
  type      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_types")
}

model Expense {
  id            String      @id @default(cuid())
  expenseTypeId String      @map("expense_type_id")
  expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id])
  storeId       String      @map("store_id")
  store         Store       @relation(fields: [storeId], references: [id])
  amount        Float
  date          DateTime
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("expenses")
}

model AssetImage {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url       String
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("asset_images")
}

model AssetType {
  id        String   @id @default(cuid())
  type      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets Asset[]

  @@map("asset_types")
}

model Asset {
  id                String      @id @default(cuid())
  storeId           String      @map("store_id")
  store             Store       @relation(fields: [storeId], references: [id])
  assetTypeId       String      @map("asset_type_id")
  assetType         AssetType   @relation(fields: [assetTypeId], references: [id])
  purchaseDate      DateTime    @map("purchase_date")
  amount            Float
  serialNumber      String      @map("serial_number")
  yearOfManufacture Int         @map("year_of_manufacture")
  currentHolderId   String?     @map("current_holder_id")
  currentHolder     TeamMember? @relation(fields: [currentHolderId], references: [id])
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  images  AssetImage[]
  history AssetHistory[]

  @@map("assets")
}

model AssetHistory {
  id           String     @id @default(cuid())
  assetId      String     @map("asset_id")
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  returnedAt   DateTime?  @map("returned_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("asset_history")
}

model Invoice {
  id          String    @id @default(cuid())
  issuerTitle String    @map("issuer_title")
  amount      Float
  paid        Boolean   @default(false)
  paidDate    DateTime? @map("paid_date")
  dueDate     DateTime  @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("invoices")
}

model JobApplication {
  id                  String         @id @default(cuid())
  fullName            String         @map("full_name")
  phone               String
  email               String
  salaryGrossEur      Int            @map("salary_gross_eur")
  salaryGrossMkd      Int            @map("salary_gross_mkd")
  salaryNetEur        Int            @map("salary_net_eur")
  salaryNetMkd        Int            @map("salary_net_mkd")
  roleId              String?        @map("role_id")
  role                CandidateRole? @relation(fields: [roleId], references: [id])
  jobTitle            String         @map("job_title")
  jobId               String?        @map("job_id")
  job                 Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cvLink              String         @map("cv_link")
  taskLink            String?        @map("task_link")
  hrInterviewTime     DateTime?      @map("hr_interview_time")
  firstInterviewTime  DateTime?      @map("first_interview_time")
  secondInterviewTime DateTime?      @map("second_interview_time")
  hrNotes             String?        @map("hr_notes")
  techNotes           String?        @map("tech_notes")
  // On hold: kept (not blocked) but skipped by AI scans and screenings
  onHold              Boolean        @default(false) @map("on_hold")
  holdReason          String?        @map("hold_reason")
  heldAt              DateTime?      @map("held_at")
  rejectionSentAt     DateTime?      @map("rejection_sent_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  screeningResults CvScreeningResult[]
  profile          CandidateProfile?
  analysisJob      CandidateAnalysisJob?

  @@map("job_applications")
}

// Emails we no longer accept job applications from
model BlockedApplicant {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_applicants")
}

// Public portfolio entries shown on /clients (separate from billing Client)
model CaseStudy {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  industry          String
  location          String
  headline          String
  summary           String
  services          String[] @default([])
  technologies      String[] @default([])
  color             String
  logoImage         String?  @map("logo_image")
  logoOnDark        Boolean  @default(false) @map("logo_on_dark")
  // When false the public site hides the name, logo and testimonial author,
  // shows anonymousName instead and rewrites mentions to "the client"
  showClient        Boolean  @default(true) @map("show_client")
  anonymousName     String?  @map("anonymous_name")
  coverImage        String?  @map("cover_image")
  challengeImage    String?  @map("challenge_image")
  outcomeImage      String?  @map("outcome_image")
  stats             Json     @default("[]")
  challenge         String
  steps             Json     @default("[]")
  outcome           String
  testimonialQuote  String?  @map("testimonial_quote")
  testimonialAuthor String?  @map("testimonial_author")
  testimonialRole   String?  @map("testimonial_role")
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

// An AI pass over CVs against free-text criteria written by HR
model CvScreening {
  id          String         @id @default(cuid())
  criteria    String
  roleId      String?        @map("role_id")
  role        CandidateRole? @relation(fields: [roleId], references: [id])
  appliedFrom DateTime?      @map("applied_from")
  // running | done | interrupted
  status      String         @default("running")
  // Why an interrupted run stopped, e.g. out of API credits
  stopReason  String?        @map("stop_reason")
  total       Int            @default(0)
  processed   Int            @default(0)
  createdById String?        @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  finishedAt  DateTime?      @map("finished_at")

  results CvScreeningResult[]

  @@map("cv_screenings")
}

model CvScreeningResult {
  id              String         @id @default(cuid())
  screeningId     String         @map("screening_id")
  screening       CvScreening    @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  applicationId   String         @map("application_id")
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // match | no_match | unclear | error
  verdict         String
  yearsExperience Float?         @map("years_experience")
  skills          String[]       @default([])
  reason          String
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([screeningId, applicationId])
  @@index([screeningId, verdict])
  @@map("cv_screening_results")
}

// What the AI read from an application's CV; one per application, so each CV is scanned once
model CandidateProfile {
  id              String         @id @default(cuid())
  applicationId   String         @unique @map("application_id")
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // done | error (errors are retried on the next scan)
  status          String
  error           String?
  primarySkills   String[]       @default([]) @map("primary_skills")
  allSkills       String[]       @default([]) @map("all_skills")
  yearsExperience Float?         @map("years_experience")
  about           String?
  summary         String?
  // Plain text pulled from the PDF locally, kept for future local search
  cvText          String?        @map("cv_text")
  model           String?
  scannedAt       DateTime       @default(now()) @map("scanned_at")

  @@index([status])
  @@map("candidate_profiles")
}

// Queue of CV analyses for the AI Operations Copilot (one job per application).
// status: pending | processing | completed | failed (CHECK constraint in the migration)
model CandidateAnalysisJob {
  id            String         @id @default(cuid())
  applicationId String         @unique @map("application_id")
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status        String         @default("pending")
  attempts      Int            @default(0)
  maxAttempts   Int            @default(3) @map("max_attempts")
  lastError     String?        @map("last_error")
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz
  lockedAt      DateTime?      @map("locked_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz

  // candidate_analysis_jobs_pending_idx (next_attempt_at, created_at) WHERE status = 'pending'
  // lives only in the migration SQL: Prisma 7.3 can't express partial indexes and ignores them
  @@map("candidate_analysis_jobs")
}

// Photographed fiscal receipts (фискална сметка). Everything below the image is read from it
// by Claude (Haiku); when the date can't be read the upload date is used. Date, total, merchant,
// category and payment method can be corrected by hand.
model Receipt {
  id                String    @id @default(cuid())
  // Photo cut down to the receipt (or the original photo when no crop was needed);
  // null for a receipt entered by hand without a photo
  imageUrl          String?   @map("image_url")
  // The photo as taken, kept when imageUrl is a crop of it
  originalImageUrl  String?   @map("original_image_url")
  fileName          String?   @map("file_name")
  // Day of purchase; drives the year/month grouping
  date              DateTime  @db.Date
  // scanned (read from the receipt) | upload (fallback: day it was uploaded) | manual (edited)
  dateSource        String    @default("upload") @map("date_source")
  // "HH:MM" as printed after ЧАС
  time              String?
  // Total in MKD (ВКУПЕН ПРОМЕТ)
  total             Float?
  merchantName      String?   @map("merchant_name")
  merchantAddress   String?   @map("merchant_address")
  // ДАН. БРОЈ (tax number) and ДДВ БРОЈ (VAT number)
  merchantTaxNumber String?   @map("merchant_tax_number")
  merchantVatNumber String?   @map("merchant_vat_number")
  // cash | card | mixed | unknown
  paymentMethod     String?   @map("payment_method")
  // restaurant | groceries | fuel | office | transport | utilities | other (inferred, not printed)
  category          String?
  // Receipt number as printed (e.g. "0023") and the fiscal device / signature codes
  receiptNumber     String?   @map("receipt_number")
  fiscalCodes       String[]  @default([]) @map("fiscal_codes")
  vatTotal          Float?    @map("vat_total")
  // [{ group: "А", ratePercent: 18, vat: 216.61 }]
  vatBreakdown      Json?     @map("vat_breakdown")
  // [{ name, quantity, unitPrice, amount, vatGroup }]
  items             Json?
  // Earlier receipt with the same merchant, number, date and total (likely uploaded twice)
  duplicateOfId     String?   @map("duplicate_of_id")
  scanError         String?   @map("scan_error")
  scannedAt         DateTime? @map("scanned_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([date])
  @@index([merchantTaxNumber, receiptNumber])
  @@map("receipts")
}
